<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>
  <object class="GtkStringList" id="combo_card_model"/>
  <object class="GtkDialog" id="prefdialog">
    <property name="title" translatable="yes">Preferences</property>
    <child internal-child="content_area">
      <object class="GtkBox" id="dialog-vbox1">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>
        <property name="margin-top">5</property>
        <property name="margin-bottom">5</property>
        <property name="margin-start">5</property>
        <property name="margin-end">5</property>
        <child>
          <object class="GtkFrame" id="DevFrame">
            <property name="label" translatable="yes">Capture device</property>
            <property name="label-xalign">0</property>
            <child>
              <object class="GtkBox" id="device_padding">
                <property name="margin-top">10</property>
                <property name="margin-bottom">10</property>
                <property name="margin-start">12</property>
                <property name="margin-end">10</property>
                <child>
                  <object class="GtkDropDown" id="combo_card">
                    <property name="model">combo_card_model</property>
                    <property name="can-focus">False</property>
                    <property name="visible">True</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child internal-child="action_area">
      <object class="GtkBox" id="dialog-action_area1">
        <property name="orientation">horizontal</property>
        <property name="spacing">6</property>
        <property name="halign">end</property>
        <property name="margin-top">6</property>
        <property name="margin-bottom">6</property>
        <property name="margin-start">6</property>
        <property name="margin-end">6</property>
        <child>
          <object class="GtkButton" id="button2">
            <property name="label" translatable="yes">_Cancel</property>
            <property name="use-underline">True</property>
            <property name="visible">True</property>
          </object>
        </child>
        <child>
          <object class="GtkButton" id="button1">
            <property name="label" translatable="yes">_OK</property>
            <property name="use-underline">True</property>
            <property name="visible">True</property>
          </object>
        </child>
      </object>
    </child>
    <action-widgets>
      <action-widget response="-6">button2</action-widget>
      <action-widget response="-5">button1</action-widget>
    </action-widgets>
  </object>
</interface>

                                        <property name="numeric">True</property>
                                        <property name="visible">True</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkLabel" id="tx_station_color_label">
                                        <property name="label" translatable="yes">Color</property>
                                        <property name="visible">True</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkColorDialogButton" id="tx_station_color">
                                        <property name="dialog">tx_station_color_dialog</property>
                                        <property name="visible">True</property>
                                      </object>
                                    </child>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">10</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="tx_utc_caption">
                                    <property name="halign">start</property>
                                    <property name="label" translatable="yes">UTC timestamp (automatic)</property>
                                    <property name="visible">True</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">11</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="tx_utc_label">
                                    <property name="halign">start</property>
                                    <property name="visible">True</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">11</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="tx_post_id_label">
                                    <property name="halign">start</property>
                                    <property name="label" translatable="yes">Optional post-SSTV IDs</property>
                                    <property name="visible">True</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="row">12</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkBox" id="tx_post_id_options">
                                    <property name="orientation">horizontal</property>
                                    <property name="spacing">12</property>
                                    <property name="visible">True</property>
                                    <child>
                                      <object class="GtkCheckButton" id="tx_video_id_toggle">
                                        <property name="active">False</property>
                                        <property name="label" translatable="yes">VideoID (waterfall)</property>
                                        <property name="tooltip-text" translatable="yes">Draw your callsign in the receiver waterfall after the SSTV image.</property>
                                        <property name="visible">True</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkCheckButton" id="tx_cw_toggle">
                                        <property name="active">False</property>
                                        <property name="label" translatable="yes">CW callsign</property>
                                        <property name="tooltip-text" translatable="yes">Send your callsign in Morse code after the SSTV image (20 WPM, 700 Hz).</property>
                                        <property name="visible">True</property>
                                      </object>
                                    </child>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">12</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="tx_preview_button">
                                    <property name="halign">start</property>
                                    <property name="label" translatable="yes">Update preview</property>
                                    <property name="visible">True</property>
                                    <layout>
                                      <property name="column">1</property>
                                      <property name="row">13</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkFrame" id="tx_preview_frame">
                                    <property name="hexpand">True</property>
                                    <property name="label" translatable="yes">Composed image preview</property>
                                    <property name="vexpand">True</property>
                                    <property name="visible">True</property>
                                    <child>
                                      <object class="GtkPicture" id="tx_preview">
                                        <property name="alternative-text" translatable="yes">Composed SSTV image preview</property>
                                        <property name="can-shrink">True</property>
                                        <property name="content-fit">contain</property>
                                        <property name="height-request">390</property>
                                        <property name="hexpand">True</property>
                                        <property name="vexpand">True</property>
                                        <property name="visible">True</property>
                                        <property name="width-request">520</property>
                                      </object>
                                    </child>
                                    <layout>
                                      <property name="column">2</property>
                                      <property name="row">0</property>
                                      <property name="row-span">15</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkButton" id="tx_send_button">
                                    <property name="halign">end</property>
                                    <property name="visible">True</property>
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="halign">end</property>
                                        <property name="label" translatable="yes">&lt;span weight="bold"&gt;Transmit SSTV...&lt;/span&gt;</property>
                                        <property name="use-markup">True</property>
                                        <property name="visible">True</property>
                                      </object>
                                    </child>
                                    <style>
                                      <class name="destructive-action"/>
                                    </style>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="column-span">2</property>
                                      <property name="row">13</property>
                                    </layout>
                                  </object>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="tx_status">
                                    <property name="halign">start</property>
                                    <property name="hexpand">True</property>
                                    <property name="visible">True</property>
                                    <property name="wrap">True</property>
                                    <layout>
                                      <property name="column">0</property>
                                      <property name="column-span">2</property>
                                      <property name="row">14</property>
                                    </layout>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="tab">
                  <object class="GtkLabel" id="tx_tab_label">
                    <property name="label" translatable="yes">TX</property>
                    <property name="margin-bottom">2</property>
                    <property name="margin-end">5</property>
                    <property name="margin-start">5</property>
                    <property name="margin-top">2</property>
                    <property name="visible">True</property>
                  </object>
                </child>
                <child>
                  <object class="GtkBox" id="alignment12">
                    <property name="can-focus">False</property>
                    <property name="hexpand">True</property>
                    <property name="margin-bottom">10</property>
                    <property name="margin-end">10</property>
                    <property name="margin-start">10</property>
                    <property name="margin-top">10</property>
                    <property name="visible">True</property>
                    <child>
                      <object class="GtkFrame" id="SavedFrame">
                        <property name="can-focus">False</property>
                        <property name="hexpand">True</property>
                        <property name="label-xalign">0</property>
                        <property name="vexpand">True</property>
                        <property name="visible">True</property>
                        <child>
                          <object class="GtkBox" id="alignment14">
                            <property name="can-focus">False</property>
                            <property name="margin-bottom">10</property>
                            <property name="margin-end">10</property>
                            <property name="margin-start">10</property>
                            <property name="margin-top">10</property>
                            <property name="visible">True</property>
                            <child>
                              <object class="GtkScrolledWindow" id="scrolledwindow1">
                                <property name="can-focus">True</property>
                                <property name="visible">True</property>
                                <child>
                                  <object class="GtkGridView" id="SavedGridView">
                                    <property name="can-focus">True</property>
                                    <property name="hexpand">True</property>
                                    <property name="hscroll-policy">natural</property>
                                    <property name="max-columns">4</property>
                                    <property name="min-columns">4</property>
                                    <property name="vexpand">True</property>
                                    <property name="visible">True</property>
                                    <property name="vscroll-policy">natural</property>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child type="label">
                          <object class="GtkLabel" id="label14">
                            <property name="can-focus">False</property>
                            <property name="label" translatable="yes">Recent pictures</property>
                            <property name="use-markup">True</property>
                            <property name="visible">True</property>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="tab">
                  <object class="GtkLabel" id="label2">
                    <property name="can-focus">False</property>
                    <property name="label" translatable="yes">Log</property>
                    <property name="margin-bottom">2</property>
                    <property name="margin-end">5</property>
                    <property name="margin-start">5</property>
                    <property name="margin-top">2</property>
                    <property name="visible">True</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child>
          <object class="GtkLabel" id="statusbar">
            <property name="can-focus">False</property>
            <property name="visible">True</property>
            <property name="xalign">0</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
